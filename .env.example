# Required admin authentication: replace this placeholder before running.
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
KEYHOLDER_ADMIN_KEY=replace-with-a-random-secret-at-least-32-characters
# Local development path; Compose overrides this to sqlite:////data/keyholder.db.
KEYHOLDER_DATABASE_URL=sqlite:///./data/keyholder.db
# Permanent customer-facing HTTPS URL; ingress/TLS is managed separately.
KEYHOLDER_PUBLIC_BASE_URL=https://keyholder.javatechpack.ir
# Linux host networking shares VPS loopback. Keep Marzban bound to host loopback.
KEYHOLDER_MARZBAN_URL=http://127.0.0.1:8000
# Upstream authentication: set either an existing bearer token OR both username/password.
# Static tokens must be replaced on expiry; password login supports automatic refresh.
KEYHOLDER_MARZBAN_TOKEN=
KEYHOLDER_MARZBAN_USERNAME=
KEYHOLDER_MARZBAN_PASSWORD=
# HTTP timeout in seconds (1-60).
KEYHOLDER_UPSTREAM_TIMEOUT=10
# Single-worker per-minute limit: each subscription token has its own hashed bucket.
# Admin requests use a separate peer bucket; forwarded IP headers are not trusted.
KEYHOLDER_RATE_LIMIT_PER_MINUTE=60
# Optional Compose env-file selector (defaults to .env), not an application setting.
# KEYHOLDER_ENV_FILE=.env

# Authenticated URL retrieval requires a server-only Fernet key, backed up with the DB.
# Generate privately: python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
KEYHOLDER_TOKEN_ENCRYPTION_KEY=
# Default policy preserves historical deployments. Production follows the Marzban panel.
KEYHOLDER_PROFILE_SOURCE=marzban
# JSON list: only these TLS CDN destinations are delivered. Direct REALITY/IPv6 unaffected.
KEYHOLDER_ALLOWED_CDN_HOSTS=["titan.javatechpack.ir"]

# Native ECH: optional trusted delivery setting, never imported from upstream links.
# Only applies when BOTH CDN address and SNI belong to ALLOWED_CDN_HOSTS.
# Empty disables it; use a tested HTTPS DNS resolver for automatic key refresh.
KEYHOLDER_CDN_ECH_CONFIG=
