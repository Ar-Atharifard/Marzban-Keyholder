# Offline code-only build when pyproject.toml and uv.lock exactly match the base.
# Verify the base image ID and both manifests before building. Do not use this
# shortcut for dependency changes; use the main Dockerfile in that case.
ARG BASE_IMAGE=keyholder:marzban-final-f692e52
FROM ${BASE_IMAGE}
COPY --chown=10001:10001 src/keyholder /app/.venv/lib/python3.12/site-packages/keyholder
COPY --chown=10001:10001 src/keyholder /app/src/keyholder
