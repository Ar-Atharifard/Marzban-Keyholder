# Optional pilot only. Replace documentation addresses before installation.
# Bind a specific public IPv4 to coexist with systemd-resolved on 127.0.0.53.
DNSTT_LISTEN=192.0.2.10:53
DNSTT_DOMAIN=t.example.com
# This must be an authenticated proxy listener, never an unauthenticated SOCKS proxy.
# Verify the actual upstream port in your deployment.
DNSTT_UPSTREAM=127.0.0.1:19053
# Maximum DNS response payload, not the network interface MTU.
DNSTT_MTU=1232
