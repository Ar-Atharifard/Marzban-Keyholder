[Unit]
Description=REALITY forward backhaul (client)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
User=keyholder-tunnel
Group=keyholder-tunnel
ExecStart=/opt/marzban-node/assets/xray run -config /etc/keyholder-forward/client.json
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LimitNOFILE=8192
Environment=GOMEMLIMIT=48MiB
MemoryHigh=64M
MemoryMax=128M

[Install]
WantedBy=multi-user.target
