[Unit]
Description=REALITY forward backhaul (server)
After=network-online.target keyholder-foreign-exit.service
Wants=network-online.target keyholder-foreign-exit.service
StartLimitIntervalSec=0

[Service]
User=keyholder-exit
Group=keyholder-exit
ExecStart=/var/lib/marzban/xray-core/xray run -config /etc/keyholder-forward/server.json
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LimitNOFILE=8192
Environment=GOMEMLIMIT=48MiB
MemoryHigh=64M
MemoryMax=128M

[Install]
WantedBy=multi-user.target
