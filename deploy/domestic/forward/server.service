[Unit]
Description=REALITY forward backhaul (server)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
User=keyholder-exit
Group=keyholder-exit
ExecStart=/var/lib/marzban/xray-core/xray run -config /etc/keyholder-forward/server.json
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LimitNOFILE=8192
MemoryHigh=32M
MemoryMax=64M

[Install]
WantedBy=multi-user.target
