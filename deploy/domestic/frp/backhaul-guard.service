[Unit]
Description=Recover a stalled reverse listener while its alternate path is healthy
After=haproxy.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/keyholder-admin/backhaul_guard.py
User=root
UMask=0077
Nice=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/keyholder-domestic
MemoryMax=32M
TimeoutStartSec=30
