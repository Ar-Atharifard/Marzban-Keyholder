# Insert inside the foreign gateway's http block after issuing the public certificate.
server {
    listen 127.0.0.1:18443 ssl;
    http2 on;
    server_name __PUBLIC_HOST__;
    ssl_certificate /etc/nginx/certs/subscription.crt;
    ssl_certificate_key /etc/nginx/certs/subscription.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_verify_client off;
    ssl_session_cache shared:SubscriptionTLS:1m;
    ssl_session_timeout 10m;
    access_log off;
    error_log /dev/null crit;

    location /s/ {
        limit_except GET { deny all; }
        proxy_pass http://127.0.0.1:18000;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host __PUBLIC_HOST__;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Real-IP "";
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
        proxy_buffering off;
        proxy_cache off;
        add_header Cache-Control "private, no-store" always;
    }
    location = /admin { return 404; }
    location ^~ /admin/ { return 404; }
    location = /health { return 404; }
    location / { root /usr/share/nginx/html; try_files $uri $uri/ /index.html; }
}
