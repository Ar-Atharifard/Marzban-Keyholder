# Store as /etc/keyholder/monitor.env, owned by root with mode 0600.
KEYHOLDER_ALERT_BOT_TOKEN=
KEYHOLDER_ALERT_CHAT_ID=
KEYHOLDER_HEARTBEAT_URL=

# Optional private overrides. HTTPS required except a loopback API emulator.
KEYHOLDER_ALERT_API_BASE=https://api.telegram.org
KEYHOLDER_ALERT_REQUEST_TIMEOUT=10
KEYHOLDER_HEARTBEAT_REQUEST_TIMEOUT=10
