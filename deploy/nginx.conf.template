# Generic host-Nginx example. Replace __PUBLIC_HOST__ and certificate paths.
# Never enable access/error path logging for bearer subscriptions.
worker_processes 1;
error_log /dev/null crit;
pid /tmp/nginx.pid;

events { worker_connections 256; }

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log off;
    server_tokens off;
    sendfile on;
    keepalive_timeout 30s;
    client_max_body_size 1m;

    server {
        listen 80 default_server;
        listen [::]:80 default_server;
        server_name _;
        return 444;
    }

    server {
        listen 80;
        listen [::]:80;
        server_name __PUBLIC_HOST__;
        return 308 https://__PUBLIC_HOST__$request_uri;
    }

    server {
        listen 443 ssl default_server;
        listen [::]:443 ssl default_server;
        ssl_reject_handshake on;
    }

    server {
        listen 443 ssl;
        listen [::]:443 ssl;
        http2 on;
        server_name __PUBLIC_HOST__;
        ssl_certificate /etc/nginx/certs/origin.pem;
        ssl_certificate_key /etc/nginx/certs/origin.key;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_cache shared:TLS:1m;
        ssl_session_timeout 10m;

        # Subscription tokens occur in request paths. Neither access nor error
        # logs may record those paths. Keep this rule when editing this file.
        access_log off;
        error_log /dev/null crit;

        location /s/ {
            limit_except GET { deny all; }
            proxy_pass http://127.0.0.1:18000;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_connect_timeout 3s;
            proxy_read_timeout 15s;
            proxy_buffering off;
            proxy_cache off;
            add_header Cache-Control "private, no-store" always;
        }

        # Administrator APIs and health checks remain loopback-only.
        # Replace this fallback only after existing static-site use is reviewed.
        location = /admin { return 404; }
        location ^~ /admin/ { return 404; }
        location = /health { return 404; }
        location / { root /usr/share/nginx/html; try_files $uri $uri/ /index.html; }
    }
}
