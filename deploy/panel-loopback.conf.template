# Include inside nginx's http block. Render placeholders only on the VPS.
# Route here ONLY through an Access-validating tunnel; never bind a public address.
map $http_cookie $panel_entry_allowed {
    default 0;
    "~(?:^|;[ ]*)__Host-panel-entry=__ENTRY_COOKIE__(?:;|$)" 1;
}

server {
    listen 127.0.0.1:18081;
    server_name edge.javatechpack.ir;
    access_log off;
    error_log /dev/null crit;
    add_header Cache-Control "no-store" always;
    location = /__PRIVATE_ENTRY__ {
        add_header Cache-Control "no-store" always;
        add_header Set-Cookie "__Host-panel-entry=__ENTRY_COOKIE__; Path=/; Secure; HttpOnly; SameSite=Strict" always;
        return 302 /dashboard/;
    }
    location / {
        if ($panel_entry_allowed = 0) { return 404; }
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_connect_timeout 3s;
        proxy_read_timeout 60s;
        proxy_cache off;
    }
}
