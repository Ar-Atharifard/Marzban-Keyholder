# Install as /etc/keyholder/recovery.env, root:root 0600. Never commit real values.
RESTIC_REPOSITORY=s3:https://s3.YOUR_REGION.backblazeb2.com/YOUR_PRIVATE_BUCKET/keyholder
RESTIC_PASSWORD_FILE=/etc/keyholder/recovery-password
AWS_ACCESS_KEY_ID=YOUR_BUCKET_RESTRICTED_APPLICATION_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_BUCKET_RESTRICTED_APPLICATION_KEY
AWS_DEFAULT_REGION=YOUR_REGION
RESTIC_CACHE_DIR=/var/cache/keyholder-recovery
GOGC=50
