[Unit]
Description=Keyholder host and customer health monitor
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/keyholder-admin/monitor.py
User=root
Group=root
UMask=0077
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/keyholder-monitor
ReadOnlyPaths=/etc/keyholder /var/lib/marzban /var/backups/keyholder /var/run/docker.sock
MemoryMax=64M
CPUQuota=20%
TimeoutStartSec=45
SuccessExitStatus=1

