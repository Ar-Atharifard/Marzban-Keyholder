[Unit]
Description=Verify and compact encrypted recovery repository
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/keyholder/recovery.env

[Service]
Type=oneshot
User=root
UMask=0077
EnvironmentFile=/etc/keyholder/recovery.env
ExecStart=/usr/bin/python3 /usr/local/lib/keyholder-recovery/recovery.py maintain --work /var/lib/keyholder-recovery
Nice=15
IOSchedulingClass=idle
CPUQuota=50%
MemoryHigh=192M
MemoryMax=320M
TimeoutStartSec=1h
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/keyholder-recovery /var/cache/keyholder-recovery

