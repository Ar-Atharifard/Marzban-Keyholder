  "schemas": {
    "CustomerCreate": {
      "additionalProperties": false,
      "properties": {
        "backend_id": {
          "default": "marzban-default",
          "pattern": "^[a-zA-Z0-9_-]{1,64}$",
          "title": "Backend Id",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "policy": {
          "$ref": "#/components/schemas/Policy"
        },
        "upstream_username": {
          "pattern": "^[a-zA-Z0-9_]{3,32}$",
          "title": "Upstream Username",
          "type": "string"
        }
      },
      "required": [
        "upstream_username",
        "name"
      ],
      "title": "CustomerCreate",
      "type": "object"
    },
    "CustomerUpdate": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Name"
        },
        "policy": {
          "anyOf": [
            {
              "$ref": "#/components/schemas/Policy"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "active",
                "disabled",
                "revoked"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Status"
        }
      },
      "title": "CustomerUpdate",
      "type": "object"
    },
    "CustomerView": {
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "mapping": {
          "$ref": "#/components/schemas/MappingInput"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "policy": {
          "$ref": "#/components/schemas/Policy"
        },
        "revoked_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Revoked At"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "status",
        "policy",
        "created_at",
        "updated_at",
        "revoked_at",
        "mapping"
      ],
      "title": "CustomerView",
      "type": "object"
    },
    "ErrorResponse": {
      "properties": {
        "detail": {
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "detail"
      ],
      "title": "ErrorResponse",
      "type": "object"
    },
    "MappingInput": {
      "additionalProperties": false,
      "properties": {
        "backend_id": {
          "default": "marzban-default",
          "pattern": "^[a-zA-Z0-9_-]{1,64}$",
          "title": "Backend Id",
          "type": "string"
        },
        "upstream_username": {
          "pattern": "^[a-zA-Z0-9_]{3,32}$",
          "title": "Upstream Username",
          "type": "string"
        }
      },
      "required": [
        "upstream_username"
      ],
      "title": "MappingInput",
      "type": "object"
    },
    "Policy": {
      "additionalProperties": false,
      "properties": {
        "profiles": {
          "items": {
            "enum": [
              "tcp_reality",
              "xhttp_reality",
              "grpc_cdn",
              "tcp_reality_ipv6",
              "shadowsocks_ipv6"
            ],
            "type": "string"
          },
          "maxItems": 5,
          "title": "Profiles",
          "type": "array"
        }
      },
      "title": "Policy",
      "type": "object"
    },
    "TokenResult": {
      "properties": {
        "customer": {
          "$ref": "#/components/schemas/CustomerView"
        },
        "subscription_url": {
          "title": "Subscription Url",
          "type": "string"
        },
        "token": {
          "title": "Token",
          "type": "string"
        }
      },
      "required": [
        "customer",
        "subscription_url",
        "token"
      ],
      "title": "TokenResult",
      "type": "object"
    }
  }
}
